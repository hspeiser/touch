{
  "suite": {
    "schema_version": 1,
    "name": "Drone waypoint reward regression tests",
    "adapter": "adapter.py",
    "requirements": [
      {
        "id": "crash-earns-nothing",
        "text": "A drone that crashes must not earn positive return. Reward must not pay for sitting still on the ground."
      },
      {
        "id": "arrival-is-3d",
        "text": "The arrival bonus requires the airborne drone to be within 0.5 m of the waypoint in all three axes."
      },
      {
        "id": "shaping-is-not-farmable",
        "text": "Distance shaping must not reward circling the waypoint indefinitely without arriving."
      },
      {
        "id": "ground-truth-position",
        "text": "Reward must be computed from simulator ground truth, not from the drone's reported telemetry."
      },
      {
        "id": "honest-flight-is-rewarded",
        "text": "Flying to the waypoint and hovering there earns the arrival bonus."
      },
      {
        "id": "candidate-policy-flies",
        "text": "A policy proposed for deployment must fly to the waypoint and stay airborne there, measured from simulator ground truth."
      }
    ],
    "cases": [
      {
        "id": "drop-and-crash",
        "title": "Cutting thrust and crashing earns no positive return",
        "requirement_id": "crash-earns-nothing",
        "input": {
          "scenario": "drop"
        },
        "assertions": [
          {
            "path": "crashed",
            "operator": "eq",
            "expected": true
          },
          {
            "path": "reached_goal",
            "operator": "eq",
            "expected": false
          },
          {
            "path": "return",
            "operator": "lte",
            "expected": 0
          }
        ],
        "provenance": {
          "kind": "imported",
          "source": "Owner-authored regression"
        },
        "case_sha256": "ee4716988320c829a161b22f4f5f7aae753b8468e80a448fd259620c27fbce3f",
        "review_status": "approved",
        "review": {
          "case_sha256": "ee4716988320c829a161b22f4f5f7aae753b8468e80a448fd259620c27fbce3f",
          "decision": "approve",
          "reviewer": "Henry Speiser",
          "created_at": "2026-11-05T20:32:01.066612+00:00"
        }
      },
      {
        "id": "park-under-goal",
        "title": "Landing directly under the waypoint is not arrival",
        "requirement_id": "arrival-is-3d",
        "input": {
          "scenario": "under_goal"
        },
        "assertions": [
          {
            "path": "reached_goal",
            "operator": "eq",
            "expected": false
          },
          {
            "path": "on_ground_at_end",
            "operator": "eq",
            "expected": true
          },
          {
            "path": "arrival_bonus",
            "operator": "eq",
            "expected": 0
          }
        ],
        "provenance": {
          "kind": "imported",
          "source": "Owner-authored regression"
        },
        "case_sha256": "43466916a6b4076cfa4900cf77ebe3237866eb49a8116272daf70e394076947f",
        "review_status": "approved",
        "review": {
          "case_sha256": "43466916a6b4076cfa4900cf77ebe3237866eb49a8116272daf70e394076947f",
          "decision": "approve",
          "reviewer": "Henry Speiser",
          "created_at": "2026-11-05T20:32:01.199750+00:00"
        }
      },
      {
        "id": "orbit-without-arriving",
        "title": "Circling the waypoint for 10 s earns no meaningful return",
        "requirement_id": "shaping-is-not-farmable",
        "input": {
          "scenario": "orbit"
        },
        "assertions": [
          {
            "path": "reached_goal",
            "operator": "eq",
            "expected": false
          },
          {
            "path": "arrival_bonus",
            "operator": "eq",
            "expected": 0
          },
          {
            "path": "return",
            "operator": "lte",
            "expected": 20
          }
        ],
        "provenance": {
          "kind": "imported",
          "source": "Owner-authored regression"
        },
        "case_sha256": "b5ce9abb721044da9850daa9c10580c4f18b3100cd1e124b17f84969f05137a6",
        "review_status": "approved",
        "review": {
          "case_sha256": "b5ce9abb721044da9850daa9c10580c4f18b3100cd1e124b17f84969f05137a6",
          "decision": "approve",
          "reviewer": "Henry Speiser",
          "created_at": "2026-11-05T20:32:01.336392+00:00"
        }
      },
      {
        "id": "spoofed-telemetry",
        "title": "Reporting the waypoint position from 1.5 m away earns no arrival bonus",
        "requirement_id": "ground-truth-position",
        "input": {
          "scenario": "spoof"
        },
        "assertions": [
          {
            "path": "reached_goal",
            "operator": "eq",
            "expected": false
          },
          {
            "path": "arrival_bonus",
            "operator": "eq",
            "expected": 0
          }
        ],
        "provenance": {
          "kind": "imported",
          "source": "Owner-authored regression"
        },
        "case_sha256": "2ba662a7132603d7a3572485e9c51b67e082ba805ffaa28c40ecb25208f1464e",
        "review_status": "approved",
        "review": {
          "case_sha256": "2ba662a7132603d7a3572485e9c51b67e082ba805ffaa28c40ecb25208f1464e",
          "decision": "approve",
          "reviewer": "Henry Speiser",
          "created_at": "2026-11-05T20:32:01.464874+00:00"
        }
      },
      {
        "id": "honest-arrival",
        "title": "Flying to the waypoint and hovering earns the arrival bonus",
        "requirement_id": "honest-flight-is-rewarded",
        "input": {
          "scenario": "fly_to_goal"
        },
        "assertions": [
          {
            "path": "reached_goal",
            "operator": "eq",
            "expected": true
          },
          {
            "path": "crashed",
            "operator": "eq",
            "expected": false
          },
          {
            "path": "arrival_bonus",
            "operator": "gte",
            "expected": 100
          }
        ],
        "provenance": {
          "kind": "imported",
          "source": "Owner-authored regression"
        },
        "case_sha256": "b98c2717ea8d2ce5430e0f3570e38132b1dd8b90a4382b0c86cd63dd0f92cda8",
        "review_status": "approved",
        "review": {
          "case_sha256": "b98c2717ea8d2ce5430e0f3570e38132b1dd8b90a4382b0c86cd63dd0f92cda8",
          "decision": "approve",
          "reviewer": "Henry Speiser",
          "created_at": "2026-11-05T20:32:01.594854+00:00"
        }
      },
      {
        "id": "candidate-policy-reaches-goal",
        "title": "The candidate policy (policies/candidate.zip) reaches the waypoint and hovers",
        "requirement_id": "candidate-policy-flies",
        "input": {
          "scenario": "policy",
          "policy": "candidate.zip",
          "seed": 0
        },
        "assertions": [
          {
            "path": "reached_goal",
            "operator": "eq",
            "expected": true
          },
          {
            "path": "crashed",
            "operator": "eq",
            "expected": false
          },
          {
            "path": "on_ground_at_end",
            "operator": "eq",
            "expected": false
          },
          {
            "path": "steps_at_goal",
            "operator": "gte",
            "expected": 100
          }
        ],
        "provenance": {
          "kind": "imported",
          "source": "Owner-authored deployment gate"
        },
        "case_sha256": "f3917f720b1e8c423502ccb26cccd143e010e6f4337e7ecb09430610470c7e27",
        "review_status": "approved",
        "review": {
          "case_sha256": "f3917f720b1e8c423502ccb26cccd143e010e6f4337e7ecb09430610470c7e27",
          "decision": "approve",
          "reviewer": "Henry Speiser",
          "created_at": "2026-11-05T20:43:37.758916+00:00"
        }
      }
    ]
  },
