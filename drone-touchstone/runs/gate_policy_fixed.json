  "suite": {
    "schema_version": 1,
    "name": "Drone waypoint reward regression tests",
    "adapter": "adapter.py",
    "requirements": [
      {
        "id": "crash-earns-nothing",
        "text": "A drone that crashes must not earn positive return. Reward must not pay for sitting still on the ground."
      },
      {
        "id": "arrival-is-3d",
        "text": "The arrival bonus requires the airborne drone to be within 0.5 m of the waypoint in all three axes."
      },
      {
        "id": "shaping-is-not-farmable",
        "text": "Distance shaping must not reward circling the waypoint indefinitely without arriving."
      },
      {
        "id": "ground-truth-position",
        "text": "Reward must be computed from simulator ground truth, not from the drone's reported telemetry."
      },
      {
        "id": "honest-flight-is-rewarded",
        "text": "Flying to the waypoint and hovering there earns the arrival bonus."
      },
      {
        "id": "candidate-policy-flies",
        "text": "A policy proposed for deployment must fly to the waypoint and stay airborne there, measured from simulator ground truth."
      }
    ],
